piano.example.com {
    root * /srv/my_piano/dist
    encode zstd gzip
    header {
        Cache-Control "no-cache"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "frame-ancestors 'none'; form-action 'none'; base-uri 'none'; object-src 'none'"
        Permissions-Policy "midi=(self), fullscreen=(self)"
    }
    file_server
}
